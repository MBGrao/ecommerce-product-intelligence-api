# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is excluded via .gitignore.

# Required: key clients must send in the X-API-Key header.
# Generate a strong value with: openssl rand -hex 32
API_KEY=

# Required for image analysis: Google Cloud Vision API key
GOOGLE_API_KEY=

USE_PLAYWRIGHT=true
YER_PER_USD=250.0
STRICT_PARTIAL_FROM_SCRAPE=true
REQUEST_HARD_TIMEOUT_MS=30000
PARTIAL_TIMEOUT_MS=15000
QUICK_SCRAPE_TIMEOUT_MS=10000
ALLOWED_SCRAPING_DOMAINS=aliexpress.com,amazon.com,noon.com,souq.com
USE_GOOGLE_SHOPPING=true
MAX_IMAGE_BYTES=10485760
QUICK_HTML_MAX_BYTES=1048576
